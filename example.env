OFX_OUTPUT_DIR=./ofx_output
DATABASE_PATH=bankferry.db
DRY_RUN=true
GNUCASH_FILE=/path/to/your/finances.gnucash

# Both programs: the HTTPS host[:port] your browser reaches the link server at,
# for OAuth banks (Chase). The redirect URI registered with Plaid is then
# https://<host>/oauth-return. Leave unset if no linked bank uses OAuth.
#PLAID_REDIRECT_HOST=myfoo.mydomain.com

# brokerferry only: where investments snapshots are written (git-ignored).
INVESTMENTS_OUTPUT_DIR=./investments_output
